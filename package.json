{
  "name": "narodniy-vpn",
  "private": true,
  "version": "1.2.8",
  "description": "Народный VPN - Свободный доступ к интернету", 
  "author": "Narodniy VPN Team",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "obfuscate": "javascript-obfuscator dist-electron --output dist-electron --compact true --self-defending true --control-flow-flattening true --dead-code-injection true --string-array true --string-array-encoding rc4",
    "dist": "npm run build && npm run obfuscate && electron-builder --win --x64",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/javascript-obfuscator": "^0.0.5",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "javascript-obfuscator": "^5.1.0",
    "postcss": "^8.5.6",
    "rollup-plugin-obfuscator": "^1.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.narodniy.vpn",
    "productName": "Народный VPN",
    "copyright": "Copyright © 2024 Narodniy VPN",
    "asar": true,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/tray.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Narodniy VPN"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Народный VPN",
      "installerIcon": "public/tray.ico",
      "uninstallerIcon": "public/tray.ico",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    }
  }
}